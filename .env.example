# Agent Reliability Platform (ARP) Configuration

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Project & Security
DEFAULT_PROJECT_ID=proj_default_production
DEFAULT_ENVIRONMENT=production
MASTER_API_KEY=arp_live_master_secret_key_change_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage
# Dual-engine: SQLite for relational metadata + DuckDB for analytical telemetry aggregates (zero-dependency default)
DATABASE_URL=sqlite:///./arp_metadata.db
DUCKDB_PATH=./arp_telemetry.duckdb

# Optional Production Storage:
# DATABASE_URL=postgresql://arp_user:arp_pass@localhost:5432/arp_db
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=9000
# CLICKHOUSE_DB=arp_analytics

# OpenTelemetry Collector
OTEL_COLLECTOR_ENDPOINT=http://localhost:4318

# Telemetry Privacy & Retention
CAPTURE_PROMPT_CONTENT=true
CAPTURE_COMPLETION_CONTENT=true
CAPTURE_TOOL_ARGUMENTS=true
CAPTURE_TOOL_RESULTS=true
TRACE_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=30
